        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Pengguna {\n        &lt;&lt;abstract&gt;&gt;\n        #nama\n        #no_hp\n        -id_pengguna\n        +peran()*\n        +detail()*\n        +tampilkan_info()\n    }\n    class Kapster {\n        +spesialisasi\n        -rating\n        +peran()\n        +detail()\n        +cek_ketersediaan()\n    }\n    class Pelanggan {\n        +status_member\n        -saldo_poin\n        +riwayat_kunjungan\n        +peran()\n        +detail()\n        +pesan_layanan()\n    }\n    class AdminBarbershop {\n        +level_akses\n        +daftar_reservasi\n        +peran()\n        +detail()\n        +laporan_pendapatan()\n    }\n    class Barbershop {\n        +nama\n        #kapster\n        +tambah_kapster()\n        +keluarkan_kapster()\n    }\n    class Reservasi {\n        +pelanggan\n        +kapster\n        +layanan\n        +hari\n        +jam\n        +pembayaran\n        -status\n        +hitung_biaya()\n        +konfirmasi()\n        +selesaikan()\n    }\n    class Pembayaran {\n        +metode\n        +status\n        +lunasi()\n        +ringkasan()\n    }\n    class Layanan {\n        +nama\n        +kategori\n        -harga\n        +harga_setelah_promo()\n    }\n\n    Pengguna &lt;|-- Kapster\n    Pengguna &lt;|-- Pelanggan\n    Pengguna &lt;|-- AdminBarbershop\n    Barbershop \&quot;1\&quot; o-- \&quot;1..*\&quot; Kapster : agregasi\n    Reservasi \&quot;1\&quot; *-- \&quot;1\&quot; Pembayaran : komposisi\n    Reservasi \&quot;*\&quot; --&gt; \&quot;1\&quot; Layanan : asosiasi\n    Reservasi \&quot;*\&quot; --&gt; \&quot;1\&quot; Kapster : asosiasi\n    Pelanggan \&quot;1\&quot; -- \&quot;*\&quot; Reservasi : asosiasi&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Vr1icZN6yOkPu3LdHq7g-1">
